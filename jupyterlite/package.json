{
  "name": "brihaspati-jupyterlite-kernel",
  "version": "0.1.0",
  "description": "बृहस्पति: a JupyterLite kernel that compiles a T1 cell with the self-hosted Sassembly compiler on yantra-wasm",
  "license": "MIT",
  "main": "lib/index.js",
  "files": ["lib/*.js"],
  "scripts": {
    "build": "jupyter builder build --development False ."
  },
  "dependencies": {
    "@jupyterlab/coreutils": "^6.6.3",
    "@jupyterlab/services": "^7.6.4",
    "@jupyterlite/services": "^0.8.3"
  },
  "devDependencies": {
    "@jupyter/builder": "^1.2.2"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "labextensions/brihaspati-jupyterlite-kernel",
    "sharedPackages": {
      "@jupyterlite/services": { "bundled": false, "singleton": true }
    }
  }
}
